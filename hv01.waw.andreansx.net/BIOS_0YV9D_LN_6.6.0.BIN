# Prints an unformatted message
_msg() {
    opts=""
    [ "$(echo -e)" != "-e" ] && opts="-e"
    line=""
    for arg in "$@"; do
        line=$line$arg
    done
    echo $opts "$line"
}

# Prints a formatted message
msgFmt() {
    which fmt > /dev/null 2>&1
    if [ $? -eq 0 ]; then
	_msg "$@" | fmt -s -w $_WIDTH
    else
	_msg "$@"
    fi
}

# Prints a formatted error message to stderr then exits false
msgErr() {
    msgFmt "$_PACKAGENAME Error: " "$@" >&2
    exit $_EXECUTION_UNSUCCESS
}

# Interactively asks customer for a yes or no answer.
# This is secure since 'look' is not used to obtain message strings.
# returns true if Yes, otherwise false.
bSecureContinueYes() {
    _MSG_PROMPT_CONTINUE="Continue executing? Y/N:"
    _MSG_PROMPT_WRONG_CHOICE="Wrong choice. Enter Y/N:\n"
    var=invalid
    badChoice=""
    while [ N != "${var}" -a Y != "${var}" -a n != "${var}" -a y != "${var}" ]; do
        printf $badChoice
        read -p "$_MSG_PROMPT_CONTINUE" var
	which tr > /dev/null 2>&1
	if [ $? -eq 0 ]; then
        	var=$(echo ${var:-invalid} | tr '[:lower:]' '[:upper:]')
	fi
        badChoice="$_MSG_PROMPT_WRONG_CHOICE"
    done
    [ $var = Y -o $var = y ]
}

# Interactively issue messages when dependent utilities are compromised.
issueSecurityPrompt() {
    ! bDependecyWarning && return

cat <<EO_RPM_MSG >&2
rpm verify output legend:
       . verification test passed
       S file Size differs
       M Mode differs (includes permissions and file type)
       5 MD5 sum differs
       D Device major/minor number mismatch
       L readLink(2) path mismatch
       U User ownership differs
       G Group ownership differs
       T mTime differs
EO_RPM_MSG

    ! bSecureContinueYes && {
        _msg "Stopping DUP execution"
        exit $_SECURITY_ERROR
    }
}

# Function verifies the security of the dependent utilities
verifySecurity() {
    # only verify on Linux systems - not mks or cygwin
    [ "$(uname -s)" = "Linux" ] || return
    _dep=""
    _rpm_err_msg=""
    _RPM_ERRORS=""

    # Get quiet and security override options for security verification.
    # Ignore getopts errors.
    while getopts ":qn" Option ${_CMDOPTS}; do
    case $Option in
        q) _VAL_QUIET=$_TRUE
            ;;
        n) _VAL_ALLOW_INSECURE_EXEC=$_TRUE
            ;;
        *)
            ;;
    esac
    done
	
	echo "${_CMDOPTS}" | grep -e "-q[[:space:]]" > /dev/null 2>&1
    if [ $? -eq 1 ]; then
		echo "${_CMDOPTS}" | grep -e "-q$" > /dev/null 2>&1
        if [ $? -eq 1 ]; then
			_VAL_QUIET=$_FALSE
        fi
    fi
	
	echo "${_CMDOPTS}" | grep -e "-n[[:space:]]" > /dev/null 2>&1
    if [ $? -eq 1 ]; then
		echo "${_CMDOPTS}" | grep -e "-n$" > /dev/null 2>&1
        if [ $? -eq 1 ]; then
			_VAL_ALLOW_INSECURE_EXEC=$_FALSE
        fi
    fi

    # Make sure all the dependencies are available on the system
    which $@ >/dev/null || {
        _msg "Cannot find utilities on the system to execute package.\n" \
			"Make sure the following utilities are in the path:\n" "$@" >&2
        exit $_EXECUTION_UNSUCCESS
    }

    # Use rpm verification to identify security risks in dependent utilities
    # Only flag any changes in mode, user ownership, or group ownership 
    RPM_ERROR=$(mktemp $_TMPFILE_PREFIX-rpm_error.XXXXXXXXXX) || 
	msgErr "Cannot create temporary file for rpm error"
    _err_ix=1
    which rpm >/dev/null 2>&1
    if [ $? -eq 0 ]
    then
	    for _dep in $@; do
		_fullPath=$(which $_dep)
		 _rpm_str=$(rpm --verify -f $_fullPath \
		    | grep $_fullPath \
		    | grep -E -e ".M......|......G.|.....U..") 
		[ -z "$_rpm_str" ] || {
		    echo "rpm verify failed: $_rpm_str" >> $RPM_ERROR
		    _err_ix=$((_err_ix+1))
		    _DEP_WARNING=$_TRUE
		}
    	     done
     else
           _DEP_WARNING=$_FALSE 
     fi

    if bQuiet ; then
        bDependecyWarning && {
            bAllowInsecureExec || exit $_SECURITY_ERROR
        }
    else # interactive:
        for _rpm_err_msg in `cat $RPM_ERROR`; do
            _msg "$_rpm_err_msg" >&2
        done
        if bAllowInsecureExec; then
            bDependecyWarning && _msg "Continuing execution"
        else
            issueSecurityPrompt
        fi
    fi
	rm -f $RPM_ERROR >/dev/null 2>&1
}

# Function is the interrupted exit point for the script
InterruptScript() {
    exit $1
}

# Verify if the required amount of disk
# space (in K) is available on the host system.
chk_Free_Space() {
    [ "$(uname -s)" = "Linux" ] || [ "$(uname -s)" = "VMkernel" ]|| return
    [ -f /VERSION -o -f /VER_INFO ] && return # bypass on ELI
	dir=$1 # folder to verify
    space_k=$2
    #space_m=$(($space_k/1024))
    
    # For embedded linux (ELI), total used + available space == 0.
    # Return without error on ELI.
    blockSize=$(stat -f -c%s $dir)
    totalBlocks=$(stat -f -c%b $dir)
    total_space_m=$(($totalBlocks*$blockSize/(1024*1024)))
    [ ${total_space_m:-0} -eq 0 ] && return
    
    availableBlocks=$(stat -f -c%a $dir)
    freespace_k=$(($availableBlocks*$blockSize/1024))
    if [ ${freespace_k:-0} -lt $space_k ]; then
        df -m $dir
        msgErr  "Not enough space available in $dir folder.\n" \
            "Please make sure you have at least ${space_m}MB " \
            "of free space available in the $dir folder."
    fi
}

# Function is the common exit point for the script
EndScript() {
     iRc=$?
    [ -d $_TEMPDIR ] &&  find $_TEMPDIR | xargs chmod 0700
    rm -rf $_TEMP_ARCHIVE $_TEMP_PACKAGE_GENERATOR $_TEMP_MANIFEST_XML $_TEMPDIR 2> /dev/null
	bDeleteTempDir && [ $(ls $TMPFOLDER | wc -l 2>/dev/null) = "0" ] && rm -rf $TMPFOLDER
    sleep $_EXIT_DELAY
    trap '' EXIT
	bSysLogMessage && {
		getMessage $iRc
		logSystem $iRc "$_MESSAGE_DESCRIPTION"
	}
    [ -d "/$_RMDISK_NAME" ] && remove_ramdisk
    # Change to current directory
    cd "$_CURRDIR" > /dev/null 2>&1

    exit $iRc
}

# Concatenates Sez generator script, package.xml, and tar archive files into Dup package
_buildPackage() {
    [ $# -eq 3 ] || msgErr "_buildPackage: requires 3 files"
    [ -f $1 ] || msgErr "_buildPackage: $1 is not a regular file"
    [ -f $2 ] || msgErr "_buildPackage: $2 is not a regular file"
    [ -f $3 ] || msgErr "_buildPackage: $3 is not a regular file"
    cat "$1" || return $?
    echo
    echo $_MANIFEST_XML_MARKER
    cat "$2" $_PACKAGE_NL || return $?
    echo
    echo $_DUP_ARCHIVE_MARKER
    cat "$3" || return $?
}

# Finds the line number of a marker in the Dup package file
_getMarkerLine() {
    grep -m1 -an "^$1" $_PACKAGENAME | cut -d ":" -f 1
}

# Extracts the Sez generator script, package.xml, or tar archive file from the Dup package file
_extract() {
    iManifest=$(_getMarkerLine "$_MANIFEST_XML_MARKER")
    iArchive=$(_getMarkerLine "$_DUP_ARCHIVE_MARKER")
    iDupGen1=$((iManifest-2))
    iPackage0=$((iManifest+1))
    iPackage1=$((iArchive-2))
    iArchive0=$((iArchive+1))
    case $1 in
    "$_PACKAGE_GENERATOR")
        #msgFmt "$1 offset to end: 0 to ${iDupGen1}" >&2
        head -n ${iDupGen1} $_PACKAGENAME
        ;;
    
    "$_MANIFEST_XML")
        #msgFmt "$1 offset to end: ${iPackage0} to ${iPackage1}" >&2
        head -n ${iPackage1} $_PACKAGENAME | tail -n +${iPackage0}
        ;;
    
    "$_DUP_ARCHIVE")
        #msgFmt "$1 offset: ${iArchive0}" >&2
        tail -n +${iArchive0} $_PACKAGENAME
        ;;

    *)
        msgErr "Tried to extract $1: can only extract package.xml or sampleexecution.bin"
        ;;
    esac
}

# Builds the PIE script used by the installer (spsetup.sh)
buildPIEScript() {
    echo "#!/bin/bash"
    $_XSLTPROC $_MANIFEST_XSL $_MANIFEST_XML || return $?
    $_XSLTPROC $_SPCONFIG_XSL $_SPCONFIG_XML || return $?
    $_XSLTPROC $_PIECONFIG_XSL $_PIECONFIG_XML || return $?
    # remove unnecessary files from the framework
    rm -f $_WIN_XSLTPROC 
    rm -f $_MANIFEST_XSL 
    rm -f $_SPCONFIG_XSL $_SPCONFIG_XML
    rm -f $_PIECONFIG_XSL $_PIECONFIG_XML
}

# Escape quotes in the pkgDescription entry in the PIEConfig script.
correctPIEConfigScript() {
    _TEMP_PIECONFIG_SCRIPT=$(mktemp PIECONFIG$$.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_PIECONFIG_SCRIPT "
    cat $_PIECONFIG_SCRIPT |  sed -e '
    /^pkgDescription/s,"\s*$,,g;
    /^pkgDescription/s,^pkgDescription=",pkgDescription=,g;
    /^pkgDescription/s,",\\",g;
    /^pkgDescription/s,^pkgDescription=,pkgDescription=",g;
    /^pkgDescription/s,\s*$,",g;' > $_TEMP_PIECONFIG_SCRIPT
    mv $_TEMP_PIECONFIG_SCRIPT $_PIECONFIG_SCRIPT 
}

verifyPIEExecutables() {
    . ./${_PIECONFIG_SCRIPT}
    [ -f $_PAYLOAD_DIR/$sInventoryCliBin ] ||
        msgErr "Inventory Cli binary does not exist: $_PAYLOAD_DIR/$sInventoryCliBin"
    [ -f $_PAYLOAD_DIR/$sExecutionCliBin ] ||
        msgErr "Execution Cli binary does not exist: $_PAYLOAD_DIR/$sExecutionCliBin"
}

# Corrects non-displayables in Version.txt
convertVersionFile() {
    _TEMP_VERSION_FILE=$(mktemp Version$$.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_VERSION_FILE "
    # Change double-quotes
    which tr > /dev/null 2>&1
    if [ $? = 0 ]; then
	    cat Version.txt | \
        	tr "\223" "\042" | tr "\224" "\042" > $_TEMP_VERSION_FILE
    	mv $_TEMP_VERSION_FILE Version.txt
    fi
    
}

# Generates a new Dup package file
generateNewDup() {
    currDir=$PWD # original directory

    (bDupPackage && ! bPayloadDir) || (bPayloadDir && ! bDupPackage) &&
        msgErr "Must specify --package and --payload options to generate a new DUP package."

    ! (bDupPackage && bPayloadDir) && return # Build of new Dup not requested

    # DUP package must not overwrite the SEZ generator
    [ $_DUP_PACKAGE_NAME != $_PACKAGE_GENERATOR ] || 
        msgErr "Dup Package name cannot equal $_PACKAGE_GENERATOR"

    _DUP_TARGET="$_PAYLOAD_DIR/../_DUP_PACKAGE_NAME"
    [ -h "${_DUP_TARGET%/}" ] && 
        msgErr "Security risk; DUP package file is a symbolic link: $_DUP_TARGET"
    touch $_DUP_TARGET ||
        msgErr "Unable to create DUP Package file." \
        "Please check permissions on the output directory" 
    test -f $_DUP_TARGET && rm -f $_DUP_TARGET

    vopt=""
    ## Prep payload files for archive
    cd $_PAYLOAD_DIR
    [ -e dos2unix.exe ] || msgErr "Could not find dos2unix.exe in $_PAYLOAD_DIR"
    [ -e $_MANIFEST_XML ] || msgErr "Could not find $_MANIFEST_XML in $_PAYLOAD_DIR"

    # Build the PIE script from xml files, move it to the framework folder
    [ -h "${_PIECONFIG_SCRIPT%/}" ] && 
        msgErr "Security risk; PIEConfig script is a symbolic link: $_PIECONFIG_SCRIPT"
    buildPIEScript > $_PIECONFIG_SCRIPT || msgErr "Cannot build $_PIECONFIG_SCRIPT"
    correctPIEConfigScript || msgErr "Error correcting $_PIECONFIG_SCRIPT"
    verifyPIEExecutables
    mv $_PIECONFIG_SCRIPT ./framework

    # Move sezgen package generator and xsltproc.js to parent dir.
    # They do not belong in the archive tarball.
    mv $_PACKAGE_GENERATOR .. ||
        msgErr "Cannot move file $_PACKAGE_GENERATOR in $_PAYLOAD_DIR to .."
    mv $_PACKAGE_NL .. ||
        msgErr "Cannot move file $_PACKAGE_NL in $_PAYLOAD_DIR to .."

    # Convert shell and text files to Unix format
    _DOS_2_UNIX=""
     vopt=""
    [ -e dos2unix.exe ] && _DOS_2_UNIX="./dos2unix.exe"
    [ "$(uname -s)" = "Linux" ] && _DOS_2_UNIX=$(which dos2unix)
    [ "$(uname -s)" = "Linux" ] && vopt='-q'
    [ $_VERBOSE -eq 1 ] && vopt=""

    find . -name "*.sh" | xargs chmod 775 
    find . -name "*.sh" | xargs -I '{}' $_DOS_2_UNIX $vopt '{}' || msgErr "Cannot fix script files in $_PAYLOAD_DIR"

    find . -name "*.txt" | xargs chmod 775 
    $_DOS_2_UNIX $vopt Version.txt  || msgErr "Cannot fix Version.txt file in $_PAYLOAD_DIR"
    convertVersionFile

    # Move dos2unix.exe to parent dir.
    # It does not belong in the archive tarball.
    [ -e dos2unix.exe ] && {
        mv dos2unix.exe .. ||
            msgErr "Cannot move file dos2unix.exe in $_PAYLOAD_DIR to .."
    }

    # Leave a copy of the manifest xml (package.xml) in the payload dir
    # in order to include it in the archive tarball.
    cp $_MANIFEST_XML .. || msgErr "Cannot copy file $_MANIFEST_XML in $_PAYLOAD_DIR to .."

    ## Build archive
    vopt=""
    [ $_VERBOSE -eq 1 ] && vopt=v
    [ -h "{$_DUP_ARCHIVE%/}" ] && 
        msgErr "Security risk;  $_DUP_ARCHIVE is a symbolic link"
    tar -c${vopt}zf $_DUP_ARCHIVE * || msgErr "Unable to create $_DUP_ARCHIVE tar file in $_PAYLOAD_DIR"
    mv $_DUP_ARCHIVE ..

    ## Create DUP in parent dir of the payload dir
    cd ..
    _buildPackage "$_PACKAGE_GENERATOR" "$_MANIFEST_XML" "$_DUP_ARCHIVE" > $_DUP_PACKAGE_NAME || {
        rm $_DUP_ARCHIVE
        msgErr "Unable to build Dup Package: $_DUP_PACKAGE_NAME"
    }
    chmod 766 $_DUP_PACKAGE_NAME
    rm $_DUP_ARCHIVE
    cd $currDir # Return to the original directory

    exit $_EXECUTION_SUCCESS
}

# returns true if pathname is relative
# $1 is the pathname to evaluate
isRelative() {
    case "$1" in
        [\\/]* | ?:[\\/] ) return 1;;
        *) return 0;;
    esac
}

# returns the full pathname of a folder
# $1 is the folder name evaluate
getFullPath() {
    cd "$1" >/dev/null 2>&1
    local folder="$PWD"
    cd - >/dev/null 2>&1
    echo $folder
}

# finds and returns the first valid directory in a folder name
# $1 is the folder name to search
findPath() {
    local folder="$1"
    isRelative "$folder" && {
        folder="$PWD/$folder"
    }
    # Note: last folder in loop is the root folder, /
    while [ "$(dirname "$folder")" != "$folder" ];do
        test -d "$folder" && {
            folder="$(getFullPath "$folder")"
            break
        }
        folder="$(dirname "$folder")"
    done
    echo $folder
}

# Function is used to verify the extraction folder
createExtractDir() {
    _CREATE_EXTRACT_DIR="$1"

    # FILE exists but isn't a directory
    [ -f "$_CREATE_EXTRACT_DIR" ] &&
        msgErr "File already exists: $_CREATE_EXTRACT_DIR"
    # FILE is a directory but is a symbolic link
    [ -h "${_CREATE_EXTRACT_DIR%/}" ] &&
        msgErr "Security risk; directory is a symbolic link: $_CREATE_EXTRACT_DIR"

    # Make the extract dir if it does not already exist
    [ -d "$_CREATE_EXTRACT_DIR" ] || {
        mkdir -p -m 1700 "$_CREATE_EXTRACT_DIR" >/dev/null 2>&1 ||
            msgErr "Cannot create directory $_CREATE_EXTRACT_DIR.  "\
                "Please ensure there is enough space."
    }

    _ABSPATH="$(findPath "$_CREATE_EXTRACT_DIR")"
    test -w "$_ABSPATH" ||
        msgErr "Cannot extract package to directory $_CREATE_EXTRACT_DIR.  "\
            "Directory is not writable: $_ABSPATH"
    test -O "$_ABSPATH" ||
        msgErr "Cannot extract package to directory $_CREATE_EXTRACT_DIR.  "\
            "$USER  is not owner of directory: $_ABSPATH"

    # Directory already exists. Overwrite the contents.
    if [ -d "$_CREATE_EXTRACT_DIR" ]; then
         chmod u+w "$_CREATE_EXTRACT_DIR" # Give it write permissions
    fi
}

# Function is used to extract the contents of the archive
extractDell() {
    _EXTRACT_DIR="$1"
    createExtractDir "$_EXTRACT_DIR"
		
    _TEMP_ARCHIVE=$(mktemp $_TMPFILE_PREFIX-$_PACKAGENAME$$.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_ARCHIVE "
	_ESXiSecureBoot=$(checkIfSecureBootEnabled)
	#When SecureBoot enabled in ESXi skipping size check as its taken care when Ramdisk is created
    if [ "$_ESXiSecureBoot" = 1 ]; then
		[ "$(uname -s)" = "Linux" ] || [ "$(uname -s)" = "VMkernel" ] && {
			# Verify existence of enough space to extract archive
			_DUP_SIZE=$(stat -c%s $_PACKAGENAME)
			_DUP_SIZE_K=$(($_DUP_SIZE/1024))
			# chk_Free_Space folder_to_verify required_minimum_kbytes 
			chk_Free_Space $TMPFOLDER $_DUP_SIZE_K
		}
	fi
    # Extract archive
    _extract "$_DUP_ARCHIVE" > $_TEMP_ARCHIVE 2>/dev/null ||
        msgErr "extract(): Unable to create temporary files. " \
            "Please ensure that there is enough space in the tmp folder."
	if [ "$_ESXiSecureBoot" = 1 ]; then
		[ "$(uname -s)" = "Linux" ] || [ "$(uname -s)" = "VMkernel" ] && {
			# Verify existence of enough space to unzip and untar archive
			_FULL_ARCHIVE_SIZE=$(GZIP='-q' zcat $_TEMP_ARCHIVE > /dev/null 2>&1 | wc -c)
			# Remove archive to accurately measure space required by archive and un-tarred archive
			rm -f $_TEMP_ARCHIVE
			# Add a 1 megabyte buffer to the required minimum
			_TMP_REQUIRED_SPACE_MINIMUM_K=$(((${_FULL_ARCHIVE_SIZE} + 1024 * 1024)/1024))
			_TMP_REQUIRED_SPACE_MINIMUM_K=$((_TMP_REQUIRED_SPACE_MINIMUM_K+_DUP_SIZE_K))
			# chk_Free_Space folder_to_verify required_minimum_kbytes 
			chk_Free_Space $TMPFOLDER $_TMP_REQUIRED_SPACE_MINIMUM_K

			# re-extract removed archive
			_extract "$_DUP_ARCHIVE" > $_TEMP_ARCHIVE 2>/dev/null ||
				msgErr "extract(): Unable to create temporary files. " \
					"Please ensure that there is enough space in the tmp folder."
		}
	fi

    vopt=""
    # optionally echo commands via v option
    [ $_VERBOSE -eq 1 ] && vopt=v
    GZIP="-q" tar -x${vopt}zf $_TEMP_ARCHIVE -C "$_EXTRACT_DIR" >/dev/null 2>&1 || {
         [ $? -eq 2 ] || # ignore gzip warnings, indicated by return code == 2
             msgErr "The archive cannot be extracted. Please ensure that the " \
				"archive is not corrupted and there is enough space in the tmp folder."
    }
    cd "$_EXTRACT_DIR" > /dev/null 2>&1
    _ESXiSYSTEM=$(checkIfESXi)

     if [ "$_ESXiSYSTEM" = 0 ]; then
    	chmod 0555 *
    	[ -d framework ] && {
        	find framework | xargs chmod 0555 > /dev/null 2>&1
    	}
	    [ -d ${FRAMEWORK32} ] && {
        	find ${FRAMEWORK32} | xargs chmod 0555 > /dev/null 2>&1
    	}
    	   [ -d ${FRAMEWORK64} ] && {
           find ${FRAMEWORK64} | xargs chmod 0555 > /dev/null 2>&1
   	 }
    	cd - > /dev/null 2>&1
    else
		chmod 1555 *
        [ -d framework ] && {
                find framework | xargs chmod 1555 > /dev/null 2>&1
        }
            [ -d ${FRAMEWORK32} ] && {
                find ${FRAMEWORK32} | xargs chmod 1555 > /dev/null 2>&1
        }
           [ -d ${FRAMEWORK64} ] && {
           find ${FRAMEWORK64} | xargs chmod 1555 > /dev/null 2>&1
         }
        cd - > /dev/null 2>&1
    fi
}

mv_and_delete()
{
 _MVDIR="$1"
 _DELDIR="$2"
   mv -f ${_MVDIR}/* . > /dev/null 2>&1
   rm -rf ${_MVDIR} > /dev/null 2>&1
   if [ -d ${_DELDIR} ]
   then
        rm -rf ${_DELDIR} > /dev/null 2>&1
   fi
}
#storelib for ESX 64 bit is not available so added execption to use 32 bit
#IE's and framework
esx_os_exception_storage_dup()
{
  if [ -f /etc/vmware-release ]; then
    if [ -f ${LXNAME64}/sasdupie ]; then
       CLU_ARCH=i386
    fi
  fi
}

determine_arch()
{
    CLU_ARCH=$(uname -m)
    case ${CLU_ARCH} in
        i[3456]86)
            CLU_ARCH=i386
            ;;
        
        x86_64)
            CLU_ARCH=x86_64
            ;;
        
        *)
	    echo "Unable to determin ARCH"
            exit $FAILURE
            ;;
    esac
}
# Function is used to extract the contents of the archive
# and to move the DUP framework files to the working folder
extract() {
    _EXTRACT_DIR="$1"
    extractDell "$_EXTRACT_DIR"
    cd "$_EXTRACT_DIR" > /dev/null 2>&1
    rm -f ./QUAL_HARD_ERROR ./checkCompatDependencies > /dev/null 2>&1
    determine_arch
    if [ $CLU_ARCH = "x86_64" ];
    then
      CLU_ARCH=$( os_exception_dup $CLU_ARCH) > /dev/null 2>&1
    fi

    if [ $CLU_ARCH = "i386" ] ;
    then
        [ -d ${FRAMEWORK32} ] && {
      	mv_and_delete ${FRAMEWORK32} ${FRAMEWORK64} 
        }
        if [ -d ${LXNAME32} ]
        then
      	   mv_and_delete ${LXNAME32} ${LXNAME64}
        else
           if [ -d ${LXNAME64} ]
           then
             touch ./QUAL_HARD_ERROR > /dev/null 2>&1
           fi
        fi
    fi
    if [ $CLU_ARCH = "x86_64" ] ;
    then
        if [ -d ${LXNAME64} ]
        then
		[ -d ${FRAMEWORK64} ] && {
		  mv_and_delete ${FRAMEWORK64} ${FRAMEWORK32}
		}
      	        mv_and_delete ${LXNAME64} ${LXNAME32}
        else
		touch ./checkCompatDependencies
		[ -d ${FRAMEWORK32} ] && {
		   mv_and_delete ${FRAMEWORK32} ${FRAMEWORK64}
		}
		if [ -d ${LXNAME32} ]
		then
      	           mv_and_delete ${LXNAME32} ${LXNAME64}
		fi
        fi  
    fi    

    
    # move framework files to current folder
    _ESXiSYSTEM=$(checkIfESXi)
     if [ "$_ESXiSYSTEM" = 0 ]; then
    	[ -d framework ] && {
       		 find framework | xargs chmod 0755
	        mv -f framework/* . >/dev/null 2>/dev/null
	        rm -rf framework >/dev/null 2>&1
   	 }
  	  find . | xargs chmod 0555  > /dev/null 2>&1
	  cd - > /dev/null 2>&1
      else
	[ -d framework ] && {
                 find framework | xargs chmod 1755
                mv -f framework/* . >/dev/null 2>/dev/null
                rm -rf framework >/dev/null 2>&1
         }
          find . | xargs chmod 1555  > /dev/null 2>&1
          cd - > /dev/null 2>&1		
      fi
}

# Print the manifest (package.xml) from the Dup Package.
# Print the formatted file via xmllint if possible, otherwise use cat.
printManifestXml() {
    _TEMP_MANIFEST_XML=$(mktemp $_TMPFILE_PREFIX-$_MANIFEST_XML$$.XXXXXX) ||
        msgErr "Cannot create temporary file - _TEMP_MANIFEST_XML "
    _extract "$_MANIFEST_XML" > $_TEMP_MANIFEST_XML ||
        msgErr "printManifestXml(): Unable to create temporary files. " \
            "Please ensure that there is enough space in the temporary folder as $TMPFOLDER."
    which xmllint > /dev/null 2>&1 && xmllint --format $_TEMP_MANIFEST_XML && return
    cat $_TEMP_MANIFEST_XML
}

# Executes a package from a console
executePackage() {
	_PACKAGE_DIR=$1
    shift
    export LD_LIBRARY_PATH=$_PACKAGE_DIR:$LD_LIBRARY_PATH
    cd $_PACKAGE_DIR > /dev/null 2>&1
    _ESXiSYSTEM=$(checkIfESXi)
    if [ "$_ESXiSYSTEM" = 0 ]; then
	    chmod -R 0755 $_PACKAGE_DIR/*  # read execute permission for extracted package
    else
            chmod -R 1755 $_PACKAGE_DIR/*
    fi

    # pass on shell tracing options
    opt=""
    ixOpt=0
    set -o | grep "xtrace" | grep "on"  >/dev/null 2>&1 && opt="-x"
    #echo $SHELLOPTS | grep "xtrace" >/dev/null 2>&1 && opt="-x"
    #echo $SHELLOPTS | grep "verbose" >/dev/null 2>&1  && opt=$opt" -v"
    set -o | grep "verbose" | grep "on"  >/dev/null 2>&1 && opt="-v"
	#System logging beyond this point will be handled by spsetup
	_SYSLOG_MSG=$_FALSE
    if [ -z $_XTERMAPP ]; then
        sh ${opt} $_PACKAGE_DIR/$_INSTALLER "$@"
    else
        # Execute the package from a console
        opt=$opt" -c"
        which xterm > /dev/null && xterm -hold +ls -e "sh ${opt} $_PACKAGE_DIR/$_INSTALLER" "$@"
    fi
    _PACKAGE_STATUS=$?
    cd - > /dev/null 2>&1 # Return to the original directory
}

# Display script usage
usage() {
	iRc="$1"
	[ -z $iRc ] && iRc=$_EXECUTION_SUCCESS
    extract "$_TARGET_DIR"
    HELP_FILE_TEXT="$(cat "$_TARGET_DIR"/$_HELP_TEXT)"
    which fmt > /dev/null 2>&1
    if [ $? = 0 ]; then
        echo "$HELP_FILE_TEXT" | fmt -s -w $_WIDTH
    else
        echo "$HELP_FILE_TEXT"
    fi
    exit $iRc
}

# Verify existence of a valid option argument
verifyOptionArg() {
    arg="$1"
    echo "$arg" | grep "^-" 2>&1 >/dev/null && return $_FALSE
    [ -z "$arg" ] && return $_FALSE
    return $_TRUE
}

###############################################################################
# Main() Script
###############################################################################

#Check for root user privilege for execution of package

if [ ! isRoot ]; then
    msgErr "Package execution requires 'root' user privileges. "
fi

# Verify security dependencies before setting signal traps
which rpm >/dev/null 2>&1
if [ $? -eq 0 ]
then
    verifySecurity "rpm stat stty cut fmt tty tar gzip tail rm mkdir mktemp chmod ls basename dirname wc sleep"
else
    bESXiSYSTEM || verifySecurity "stat stty cut fmt tty tar gzip tail rm mkdir mktemp chmod ls basename dirname wc sleep"
fi

# Handle Abnormal exit conditions
trap "EndScript" EXIT
trap "InterruptScript 99" HUP INT QUIT BUS SEGV PIPE TERM # 1 2 3 10 11 13 15

 _PACKAGENAME=$(basename "$0")
 _PACKAGE_WORKDIR=$(dirname "$0")

# stty requires a terminal to get the window width
[ "$(uname -s)" = "Linux" ] && {
    # Linux only
    tty -s && _WIDTH=$(stty size | cut -f2 -d' ')
}

# Target Directory for extraction is not readonly; modifiable via '--extract' option
[ -d $TMPFOLDER ] || {
	mkdir -p $TMPFOLDER
	_DELETE_TEMP_DIR=$_TRUE
}
_TARGET_DIR=$(mktemp -d $TMPFOLDER/$_PACKAGENAME-$$.XXXXXX)
 rm rf $_TARGET_DIR >/dev/null 2>&1
 _TARGET_DIR_VALIDATE=""
_TEMPDIR="$_TARGET_DIR"

# Change to working directory
cd "$_PACKAGE_WORKDIR" > /dev/null 2>&1

_SHORT_OPTS="vhdxfqncryz:"
 _LONG_OPTS="\
verbose,\
version,\
help,\
buildVer,\
listXml,\
payload:,\
package:,\
extract:,\
list,\
debuginv,\
xml,\
queryinventory,\
selectiveupdate:,\
installpath=:,\
force:"


#echo "Input command line options are $@"
echo "$_CMDOPTS" | grep -i "*-su"
if [ $? -eq 0 ]; then
  echo "$_CMDOPTS" | grep -i " *-su *-"
  if [ $? -eq 0 ]; then
    msgFmt "Invalid option: --"
	usage $_EXECUTION_UNSUCCESS
  fi
fi

#echo "The  passed command line options are $@"
_PASSTHRU_ARGS=""
_TEMP_ARGS=""
echo "$@" | grep "passthrough=" 2>&1 > /dev/null
if [ 0 -eq "$?" ]; then
    for token in "$@"
    do
        echo "$token" | grep "passthrough=" 2>&1 > /dev/null
        if [ 0 -ne "$?" ]; then
            _TEMP_ARGS="$_TEMP_ARGS $token"        
        else
            _PASSTHRU_ARGS="$token"
        fi	
    done
    _TEMP_ARGS=$(echo "$_TEMP_ARGS" | sed 's/^ //')
    set -- "$_TEMP_ARGS"
	_CMDOPTS="$_TEMP_ARGS"
fi
set -- $(echo "$@" | sed 's/?/h/g')
set -- $(echo "$@" | sed 's/-qi/-y/g')
set -- $(echo "$@" | sed 's/--queryinventory/-y/g')
set -- $(echo "$@" | sed 's/-su/-z/g')
set -- $(echo "$@" | sed 's/--selectiveupdate/-z/g')
#echo "The passed command line options after replacing qi and su with y and z are $@"

# '--' as a first or last argument is invalid
# '--' will be set as a valid last argument by 'set --' command below
eval _last_arg=\$$#
[ "$1" = "--"  -o "$_last_arg" = "--" ] && {
    msgFmt "Invalid option: --"
    usage $_EXECUTION_UNSUCCESS
}

_HELP_OPTS=$(echo "$@" | egrep -e "-\?|-help")
 _EXTRACT_OPTS=$(echo "$@" | grep "\-\-extract")
 _INSTALL_OPTS=$(echo "$@" | grep "\-\-installPath")
 
if [ 0 -eq "$?" ]; then
    for token in "$@"
    do
        echo "$token" | grep "\-\-installpath=" 2>&1 > /dev/null
        if [ 0 -eq "$?" ]; then
             _INSTALLPATH_ARGS="$token"
        fi
    done
fi


[ -n "$_EXTRACT_OPTS" ] && export GETOPT_COMPATIBLE=1 # must use old getopt
[ -n "$_INSTALL_OPTS" ] && export GETOPT_COMPATIBLE_INSTALLPATH=1 # must use old getopt
[ -n "$_HELP_OPTS" ] && set -- -h # change -? to -h
 _OPTOUT=""
getopt -T > /dev/null 2>&1
_GETOPT_RC=$?
if [ $_GETOPT_RC -eq 4 ]; then
    
    if [ -n "$_PASSTHRU_ARGS" ]; then
        #validate passthru is valid
        _OPTOUT=$(getopt -l "passthrough:" "" "$_PASSTHRU_ARGS" 2>&1 > /dev/null)
        [ $? -ne 0 ] && {
            msgFmt "$(echo "$_OPTOUT" | sed 's,getopt:,,g')"
            exit $_EXECUTION_UNSUCCESS
	}
    fi
	if [ -n "$_INSTALLPATH_ARGS" ]; then
        #validate installpath is valid
        _OPTOUT=$(getopt -l "installpath:" "" "$_INSTALLPATH_ARGS" 2>&1 > /dev/null)
        [ $? -ne 0 ] && {
            msgFmt "$(echo "$_OPTOUT" | sed 's,getopt:,,g')"
            exit $_EXECUTION_UNSUCCESS
        }
    fi


    # Enhanced version of getopt is available
    # to parse and report its option parsing errors.
    _OPTOUT=$(getopt -l $_LONG_OPTS $_SHORT_OPTS "$@" 2>&1 >/dev/null)
    [ $? -ne 0 ] && {
        msgFmt "$(echo "$_OPTOUT" | sed 's,getopt:,,g')"
        usage $_EXECUTION_UNSUCCESS
    }
    set -- $(getopt -u -l $_LONG_OPTS $_SHORT_OPTS "$@")
fi

# check options over here..
_LIMIT=0
while [ -n "$1" ]; do
    case $1 in
    --verbose)  # Display verbose info
        _VERBOSE=1
        shift
        ;;
    -v | --version)  # Display Version Information
        _VAL_VERSION=$_TRUE
        shift
        ;;
    -h | "-?" | --help) # Display help
        _VAL_HELP=$_TRUE
        shift
        ;;
    --buildVer)  # Display build number
		[bQueryInventory || bSelectiveUpdate] &&  usage $_EXECUTION_UNSUCCESS
        extract "$_TARGET_DIR"
        executePackage "$_TARGET_DIR" --buildVer
        exit $_EXECUTION_SUCCESS
        ;;
    --listXml)
        _VAL_LISTXML=$_TRUE
        shift
        ;;
    --payload)
        _PAYLOAD_DIR="$2"
        if verifyOptionArg "$_PAYLOAD_DIR"; then
            shift 2
        else
            _PAYLOAD_DIR=""
            shift
        fi
        _VAL_PAYLOAD_DIR=$_TRUE
        ;;
    --package)
        _DUP_PACKAGE_NAME="$2"
        if verifyOptionArg "$_DUP_PACKAGE_NAME"; then
            shift 2
        else
            _DUP_PACKAGE_NAME=""
            shift
        fi
        _VAL_DUP_PACKAGE_NAME=$_TRUE
        ;;
    --extract)  # extract File Contents
        _TARGET_DIR_VALIDATE="$2"
        if verifyOptionArg "$_TARGET_DIR_VALIDATE"; then
            shift 2
        else
            _TARGET_DIR_VALIDATE=""
            shift
        fi
        _VAL_EXTRACT=$_TRUE
        ;;
    --extractDell)  # extract File Contents
        _TARGET_DIR_VALIDATE="$2"
        if verifyOptionArg "$_TARGET_DIR_VALIDATE"; then
            shift 2
        else
            _TARGET_DIR_VALIDATE=""
            shift
        fi
        _VAL_EXTRACT_DELL=$_TRUE
        ;;
	--installpath)  # 
        _VAL_INSTALLPATH_EXIST=$_TRUE
		shift 
        ;;
    --list)   # Display Archive Contents
        _VAL_LIST=$_TRUE
        shift
        ;;
    ## These are passed onto the installer: spsetup.sh
    -d | --debuginv)  # Debug Inventory processing
        shift
        ;;
    -x | --xml)  # Log XML Debug Information
        shift
        ;;
    -f)  # Forces package updates that do not pass validation
		_VAL_FORCE=$_TRUE
        shift
        ;;
    --force) # Tiered force
        [ -n "$2" ] && shift
        shift
        ;;
    -q)  # Quiet non-interactive processing
        _VAL_QUIET=$_TRUE
        shift
        ;;
	-n)  # Continue with insecure execution
        _VAL_ALLOW_INSECURE_EXEC=$_TRUE
        shift
        ;;
    -c)  # Check validation without package update
		_VAL_VALIDATION=$_TRUE
        shift
        ;;
    -r)  # Reboot required
		_VAL_REBOOT=$_TRUE
        shift
        ;;
	-y | --queryinventory)  # Selective Inventory required
		_VAL_SELECTIVE_INVENTORY=$_TRUE
       shift
	   ;;
    -z | --selectiveupdate)  # Selective Update required
		_VAL_SELECTIVE_UPDATE=$_TRUE
        shift
		;;
    *)  # Default case - invalid option
        # If only old un-enhanced version of getopt is available,
        # this script must report option parsing errors.
        getopt -T > /dev/null 2>&1
        _GETOPT_RC=$?
        if [ $_GETOPT_RC -ne 4 ]; then
            msgFmt "Invalid option: $1"
            usage $_EXECUTION_UNSUCCESS
        else
            if [ "$1" = "--" ]; then
                # options that follow the '--' option are invalid
                shift
                [ -n "$1" ] && {
                    msgFmt "Invalid option: $1"
                    usage $_EXECUTION_UNSUCCESS
                }
            else
                break
            fi
        fi
        ;;
    esac
    _LIMIT=$((_LIMIT+1))
    [ $_LIMIT -gt 100 ] && msgErr "Option limit reached; Invalid option: $1"
done


# Open an xterm window for interactive processing 
# if the DUP is executed interactively (not quiet) and is not in a terminal.
! bQuiet && {
    bNoTerminal && exec xterm +ls -e $0 $_CMDOPTS
}

## Precendence: Execute these options in the following order,
##              then exit for any processed.
bHelp && usage
bQueryInventory && {
        bSelectiveUpdate || bForce || bReboot || bValidation || bAllowInsecureExec || bList || bListXml || bHelp || bVersion || ! bQuiet || bExtract || bExtractDell || bInstallPathExist && usage $_EXECUTION_UNSUCCESS
}

bSelectiveUpdate && {
        bList || bValidation || bListXml || bHelp || bVersion || ! bQuiet || bExtract || bExtractDell || bInstallPathExist && usage $_EXECUTION_UNSUCCESS
}
bInstallPathExist && {
		bSelectiveUpdate || bValidation || bAllowInsecureExec || bList || bListXml || bHelp || bVersion || ! bQuiet || bExtract || bExtractDell && usage $_EXECUTION_UNSUCCESS
}

bVersion && {
    extract "$_TARGET_DIR"
    executePackage "$_TARGET_DIR" $_CMDOPTS
    exit $_EXECUTION_SUCCESS
}

bList && {
    # Following command displays archive contents. -l is currently being used on Windows
    # for Logging options. So using -t and --list as options for listing archive contents.
    extractDell "$_TARGET_DIR"
    ls -lRs "$_TARGET_DIR"
    exit $_EXECUTION_SUCCESS
}

bListXml && {
    printManifestXml
    exit $_EXECUTION_SUCCESS
}

# chk_Free_Space folder_to_verify required_minimum_kbytes 
# check /var here for all extract and execution options
chk_Free_Space /var $((50*1024))

bExtract || bExtractDell && {
# If any other option is passed with --extract, show help and Exit
	[ $_LIMIT -gt 1 ] && {
		msgFmt "Invalid option combination"
		usage $_EXECUTION_UNSUCCESS
	}
    [ -z "$_TARGET_DIR_VALIDATE" ] &&
        msgErr "Please provide a directory name for extraction."
    [ "$_TARGET_DIR_VALIDATE" = "/" ] &&
        msgErr "ROOT directory cannot be used for extraction."
    [ -h "${_TARGET_DIR_VALIDATE%/}" ] &&
        msgFmt "Warning: Security risk, extraction directory $_TARGET_DIR_VALIDATE "\
                "is a symbolic link."
    bExtract && extract "$_TARGET_DIR" # temporary directory
    bExtractDell && extractDell "$_TARGET_DIR" # temporary directory
  
    createExtractDir "$_TARGET_DIR_VALIDATE"
    _ESXiSYSTEM=$(checkIfESXi)
    if [ "$_ESXiSYSTEM" = 0 ]; then
    	    find "$_TARGET_DIR" | xargs chmod 0755
	    find "$_TARGET_DIR_VALIDATE" | xargs chmod 0755
    else
          find "$_TARGET_DIR" | xargs chmod 1755
	  find "$_TARGET_DIR_VALIDATE" | xargs chmod 1755
    fi
	cp -rf $_TARGET_DIR/* "$_TARGET_DIR_VALIDATE" >/dev/null 2>&1
    msgFmt "Successfully extracted to $_TARGET_DIR_VALIDATE"
    exit $_EXECUTION_SUCCESS
}

bPayloadDir && {
    [ -z "$_PAYLOAD_DIR" -o ! -d "$_PAYLOAD_DIR" ] &&
        msgErr "Please provide a directory name for the payload."
    [ "$_PAYLOAD_DIR" = "/" ] &&
        msgErr "ROOT directory cannot be used for the payload."
    [ -h "{$_PAYLOAD_DIR%/}" ] &&
        msgFmt "Warning: Security risk, payload directory $_PAYLOAD_DIR is a symbolic link."
}

bDupPackage && {
    [ -z "$_DUP_PACKAGE_NAME" ] &&
        msgErr "Please provide a name for the DUP package."
}



generateNewDup
extract "$_TARGET_DIR"

#Send DUP NAME to $_DUPNAMEFILE file 
_DUPNAME="$(basename "$0")"

echo "#!/bin/bash" > $_TARGET_DIR/$_DUPNAMEFILE
echo "_DUPNAMENOEXT=$(echo "$_DUPNAME" | awk -F '.BIN' '{print $1}')" >> $_TARGET_DIR/$_DUPNAMEFILE

# Check for root user privilege for execution of package
executePackage "$_TARGET_DIR" $_CMDOPTS "$_PASSTHRU_ARGS" 
exit $_PACKAGE_STATUS
#####Startofpackage#####
